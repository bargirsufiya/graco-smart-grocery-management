# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/grocery-management
JWT_SECRET=change-me-to-a-long-random-string

# Module 1: Google login and password reset emails
GOOGLE_CLIENT_ID=
# The website address. Only this site may call the API (CORS); also used in reset emails.
# When deployed, use your Vercel address, e.g. https://graco.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional: more allowed website addresses, comma-separated
CORS_ORIGINS=
EMAIL_USER=
EMAIL_PASS=
SENDER_NAME=Graco

# Module 5: AI assistant (Google Gemini, free tier). Get a key at https://aistudio.google.com/apikey
# Without a key, or when Gemini is unavailable, rule-based suggestions are shown instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
